<?xml version="1.0" encoding="utf-8"?>
<package >
	<metadata>
		<id>Magic.NetStandard</id>
		<version>$version$</version>
		<authors>red</authors>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<license type="expression">MIT</license>
		<projectUrl>https://github.com/hey-red/Mime</projectUrl>
		<description>.NET wrapper for libmagic</description>
		<tags>libmagic</tags>
		<dependencies>
			<group targetFramework="netstandard2.0" />
		</dependencies>
		<contentFiles>
			<files include="*.*" buildAction="Content" copyToOutput="true" />
		</contentFiles>
	</metadata>
	<files>
		<file src="..\src\Magic\content\magic.mgc" target="conentfiles/any/any" />

		<file src="..\src\Magic\runtimes\**\*.*" target="runtimes" />
		<file src="..\src\Magic\bin\Release\netstandard2.0\Magic.dll" target="lib\netstandard2.0" />
		<file src="..\src\Magic\bin\Release\netstandard2.0\Magic.xml" target="lib\netstandard2.0" />
	</files>
</package>