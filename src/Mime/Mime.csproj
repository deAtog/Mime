<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>.NET wrapper for libmagic.</Description>
		<AssemblyTitle>Mime</AssemblyTitle>
		<Version Condition="'$(Version)' == ''">3.8.1</Version>
		<Authors>red</Authors>
		<TargetFrameworks>netstandard2.0;net462</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AssemblyName>Mime</AssemblyName>
		<RootNamespace>HeyRed.Mime</RootNamespace>
		<Configurations>Debug;Release</Configurations>
		<Platforms>AnyCPU;ARM64;x64;x86</Platforms>
	</PropertyGroup>
	<PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\key.snk')">
		<AssemblyOriginatorKeyFile>..\..\..\key.snk</AssemblyOriginatorKeyFile>
		<SignAssembly Condition=" '$(Configuration)' != 'Debug' ">true</SignAssembly>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
		<PackageReference Include="MimeTypesMap" Version="1.0.9" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Properties\**" />
		<EmbeddedResource Remove="Properties\**" />
		<None Remove="Properties\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Magic\Magic.csproj" />
	</ItemGroup>
</Project>
